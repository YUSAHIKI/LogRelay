# このファイルをコピーして "keystore.properties" という名前で
# プロジェクトのルート(settings.gradle.ktsと同じ階層)に置いてください。
#
# 実際の値を埋めた keystore.properties 自体は絶対にGitにコミットしないこと。
# (.gitignore に追加済み)
#
# storeFile: keystoreファイルへのパス(絶対パス、またはプロジェクトルートからの相対パス)
storeFile=../quicklog-release.jks
storePassword=ここにキーストアのパスワード
keyAlias=quicklog
keyPassword=ここにキーのパスワード
